{
  "name": "template-dms",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project run -w",
    "frontend:dev": "ajs dms dev",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.config.json --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "test": "pnpm run build",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "sync": "antelopejs-sync --profile template",
    "sync:check": "antelopejs-sync --check --profile template"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.3.2 <1.0.0",
    "@antelopejs/interface-core": ">=0.4.1 <1.0.0",
    "@antelopejs/interface-data-api": ">=0.6.3 <1.0.0",
    "@antelopejs/interface-database": ">=0.3.2 <1.0.0",
    "@antelopejs/interface-database-decorators": ">=0.4.0 <1.0.0",
    "@antelopejs/interface-dms": "file:.tgz-deps/antelopejs-interface-dms-41d2eb4.tgz",
    "@openai/codex": "0.166.0"
  },
  "devDependencies": {
    "@antelopejs/core": "1.21.3",
    "@antelopejs/dms": "file:.tgz-deps/antelopejs-dms-41d2eb4.tgz",
    "@antelopejs/dms-assistant": "file:.tgz-deps/antelopejs-dms-assistant-cfc2c36.tgz",
    "@antelopejs/dms-frontend": ">=0.10.3 <1.0.0",
    "@antelopejs/tooling-configs": "^0.5.8",
    "@types/node": "^24.0.0",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@antelopejs/dms": "file:.tgz-deps/antelopejs-dms-41d2eb4.tgz",
      "@antelopejs/dms>@antelopejs/interface-api": "0.3.2",
      "@antelopejs/dms>@antelopejs/interface-core": "0.4.1",
      "@antelopejs/dms>@antelopejs/interface-data-api": "0.6.3",
      "@antelopejs/dms>@antelopejs/interface-database": "0.3.2",
      "@antelopejs/dms>@antelopejs/interface-database-decorators": "0.4.0",
      "@antelopejs/dms-assistant": "file:.tgz-deps/antelopejs-dms-assistant-cfc2c36.tgz",
      "@antelopejs/dms-assistant>@antelopejs/interface-api": "0.3.2",
      "@antelopejs/dms-assistant>@antelopejs/interface-core": "0.4.1",
      "@antelopejs/dms-assistant>@antelopejs/interface-database": "0.3.2",
      "@antelopejs/interface-dms": "file:.tgz-deps/antelopejs-interface-dms-41d2eb4.tgz"
    }
  },
  "antelopeJs": {
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    }
  }
}
