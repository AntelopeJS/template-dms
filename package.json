{
  "name": "template-dms",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project run -w",
    "frontend:dev": "ajs dms dev",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.config.json --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "test": "pnpm run build",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "sync": "antelopejs-sync --profile template",
    "sync:check": "antelopejs-sync --check --profile template"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.3.3 <0.4.0",
    "@antelopejs/interface-core": ">=0.5.1 <0.6.0",
    "@antelopejs/interface-data-api": ">=0.8.0 <0.9.0",
    "@antelopejs/interface-database": ">=0.4.0 <0.5.0",
    "@antelopejs/interface-database-decorators": ">=0.5.2 <0.6.0",
    "@antelopejs/interface-dms": ">=0.14.0 <0.15.0",
    "@openai/codex": "0.166.0"
  },
  "devDependencies": {
    "@antelopejs/core": "~1.23.3",
    "@antelopejs/dms-frontend": ">=0.11.1 <0.12.0",
    "@antelopejs/tooling-configs": "^0.7.1",
    "@types/node": "^24.0.0",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.33.0",
  "antelopeJs": {
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    }
  }
}
