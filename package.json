{
  "name": "template-dms",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project run -w",
    "frontend:dev": "ajs dms dev",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.config.json --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "test": "pnpm run build",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "sync": "antelopejs-sync --profile template",
    "sync:check": "antelopejs-sync --check --profile template"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.3.4 <0.4.0",
    "@antelopejs/interface-api-util": ">=0.3.3 <0.4.0",
    "@antelopejs/interface-core": ">=0.5.2 <0.6.0",
    "@antelopejs/interface-data-api": ">=0.8.2 <0.9.0",
    "@antelopejs/interface-database": ">=0.4.3 <0.5.0",
    "@antelopejs/interface-database-decorators": ">=0.5.4 <0.6.0",
    "@antelopejs/interface-dms": ">=0.16.0 <0.17.0",
    "@antelopejs/interface-file-storage": ">=0.1.9 <0.2.0",
    "@openai/codex": "0.170.0"
  },
  "devDependencies": {
    "@antelopejs/core": "~1.24.7",
    "@antelopejs/dms-frontend": ">=0.11.9 <0.12.0",
    "@antelopejs/tooling-configs": ">=0.10.0 <0.11.0",
    "@types/node": "^24.0.0",
    "knip": "^6.46.1",
    "oxfmt": "^0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.33.0",
  "antelopeJs": {
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    }
  }
}
